# ─────────────────────────────────────────────────────────────
# Farmer Assistant – Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/course_platform_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=JDBC
DB_PASSWORD=@123

# ── JWT ─────────────────────────────────────────────────────
# Must be at least 32 characters (256-bit) for HS256
JWT_SECRET=replace-with-a-long-random-secret-key-minimum-32-chars
# Token expiry in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
